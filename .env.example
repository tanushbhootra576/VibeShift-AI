# =============================================================================
# VibeShift AI - Server-Side Environment Variables (Reference)
# =============================================================================
# This file documents server-only variables (no NEXT_PUBLIC_ prefix).
# For the full client + server template, use .env.local.example instead.
# =============================================================================


# Google Gemini AI (server-side calls only)
GOOGLE_AI_API_KEY="AIza..."

# Google OAuth 2.0 (server-side token exchange)
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# NextAuth
NEXTAUTH_SECRET="your_nextauth_secret"
NEXTAUTH_URL="http://localhost:3000"

# Upstash Redis (edge rate limiting)
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"

# AES-256 key for encrypting OAuth tokens at rest in Firestore (exactly 32 bytes)
ENCRYPTION_KEY="your_32_byte_hex_string"

# Firebase Admin SDK (from Service Account JSON, server-only)
FIREBASE_PROJECT_ID="your_project_id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your_project_id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
