# =============================================================================
# VibeShift AI - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
#   cp .env.local.example .env.local
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Firebase Client SDK
#    Source: Firebase Console > Project Settings > Your apps > Web app
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project_id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"


# -----------------------------------------------------------------------------
# 2. Firebase App Check (reCAPTCHA Enterprise)
#    Source: Google Cloud Console > reCAPTCHA Enterprise > Create key (Web)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your_recaptcha_site_key"


# -----------------------------------------------------------------------------
# 3. NextAuth.js
#    Generate NEXTAUTH_SECRET with:  openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="your_random_32_byte_secret"
NEXTAUTH_URL="http://localhost:3000"


# -----------------------------------------------------------------------------
# 4. Google OAuth 2.0
#    Source: Google Cloud Console > APIs and Services > Credentials > OAuth 2.0 Client IDs
#    Required OAuth scopes: calendar.events, gmail.readonly, gmail.compose
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"


# -----------------------------------------------------------------------------
# 5. Google Gemini AI
#    Source: https://aistudio.google.com/apikey
#    Model used: gemini-2.0-flash
# -----------------------------------------------------------------------------
GOOGLE_AI_API_KEY="your_gemini_api_key"


# -----------------------------------------------------------------------------
# 6. Upstash Redis (Edge Rate Limiting)
#    Source: https://console.upstash.com > Create Database > REST API
#    Used to rate-limit AI API routes at the edge.
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"


# -----------------------------------------------------------------------------
# 7. AES-256 Token Encryption
#    Used to encrypt Google OAuth tokens before storing them in Firestore.
#    Must be exactly 32 bytes (256 bits).
#    Generate with:  openssl rand -hex 16
# -----------------------------------------------------------------------------
ENCRYPTION_KEY="your_32_byte_hex_string"
