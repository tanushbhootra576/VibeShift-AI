# =========================================================================
# VibeShift AI - Environment Variables
# Copy this file to .env.local and fill in your values.
# =========================================================================

# 1. Firebase Client Configuration (From Firebase Console -> Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY="your_api_key_here"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"

# 2. Firebase App Check (reCAPTCHA Enterprise)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your_recaptcha_site_key_here"

# 3. NextAuth Configuration
# Generate a secret via: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# 4. Google OAuth (For Google Calendar and Gmail integration)
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# 5. Google Gemini AI
GOOGLE_AI_API_KEY="your_gemini_api_key_here"

# 6. Upstash Redis (For Edge Rate Limiting)
UPSTASH_REDIS_REST_URL="your_upstash_redis_url"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# 7. Encryption (AES-256 for secure Google OAuth Tokens at rest in Firestore)
# Must be exactly 32 bytes (256 bits). You can generate one via: openssl rand -hex 16
ENCRYPTION_KEY="your_32_byte_encryption_key_here"
